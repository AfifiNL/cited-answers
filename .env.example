# Copy to .env (git-ignored). The defaults are offline and free.
# mock | openai | gemini
CA_PROVIDER=mock
# hash | openai | gemini
CA_EMBEDDER=hash
# memory | pgvector
CA_STORE=memory

# PostgreSQL + pgvector (make db-up, then make index)
# CA_STORE=pgvector
# CA_DATABASE_URL=postgresql://cited:cited@127.0.0.1:5432/cited

# Live models cost money per request. Keys are read by the vendor SDKs, never by this code.
# OPENAI_API_KEY=
# CA_OPENAI_MODEL=gpt-5-mini
# GEMINI_API_KEY=
# CA_GEMINI_MODEL=gemini-2.5-flash
# Gemini through Vertex AI instead of an API key (Application Default Credentials):
# CA_GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=
# Chat and embedding models are offered in different locations; check yours. Tested 2026-11-08:
# CA_GEMINI_MODEL=gemini-3.6-flash
# CA_GEMINI_LOCATION=eu
# CA_GEMINI_EMBEDDING_LOCATION=europe-west4
# CA_GEMINI_THINKING_LEVEL=low

# Faithfulness scoring in evals: quote (deterministic, default) | judge (quote check + LLM judge)
# CA_FAITHFULNESS_SCORER=judge
# CA_JUDGE_PROVIDER=gemini
# CA_JUDGE_MODEL=gemini-3.1-pro-preview
# CA_JUDGE_LOCATION=global

# Record/replay (make record-live / make eval-replay set these for you)
# CA_RECORD_CASSETTE=evals/fixtures/live-answers.jsonl
# CA_PROVIDER=replay
# CA_JUDGE_PROVIDER=replay
# CA_CASSETTE=evals/fixtures/live-answers.jsonl
